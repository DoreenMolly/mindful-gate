{
    "manifest_version" : 3,
    "name" : "Mindful Gate",
    "version" : "0.1",
    "description" : "Shows something meaningful before distracting sites load.",
    "permissions" : ["storage"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["images/*"], "matches": ["*://*.instagram.com/*"] }
  ]
}